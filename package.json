{
  "name": "soa-ts-prototype",
  "version": "1.0.4",
  "private": true,
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "probe": "node --experimental-transform-types tools/probe.mts",
    "e2e:web": "node tools/web-e2e.mjs",
    "e2e:web:hk": "node tools/web-e2e-hk.mjs",
    "e2e:android": "node tools/android-e2e.mjs",
    "e2e:android:hk": "node tools/android-e2e-hk.mjs",
    "e2e:web:us": "SOA_E2E_TICKER=AAPL node tools/web-e2e-hk.mjs",
    "e2e:web:hk:llm": "node --env-file=.env tools/web-e2e-hk.mjs",
    "e2e:android:us": "node tools/android-e2e-hk.mjs --ticker AAPL",
    "test:coverage": "vitest run --coverage"
  },
  "type": "module",
  "dependencies": {
    "@langchain/core": "^1.3.5",
    "@langchain/langgraph": "^1.7.2",
    "@langchain/openai": "^1.8.2",
    "iconv-lite": "^0.7.3",
    "node-tdx-market": "^0.2.1",
    "string_decoder": "^1.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.3.1",
    "@vitest/coverage-v8": "^5.1.1",
    "better-sqlite3": "^13.0.3",
    "fake-indexeddb": "^6.2.7",
    "react-test-renderer": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "//": "双 tsconfig 同 TS 大版本(root 与 app 均 ^7.0.2):根层 web/node 用 TS 原生编译器 + DOM 单源类型;app 层刻意偏离 Expo SDK 58 模板钉版 ~6.0.3(expo install --check 报版本不符属预期,勿修)——详见 .trellis/spec/ts/index.md「全局约定」"
}
