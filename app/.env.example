# Expo 客户端环境变量(浏览器可读;Expo dev/export 自动注入)
# LLM 三键兜底:设置面板未保存的键从这里补齐(对齐 Python 读 .env 语义)
EXPO_PUBLIC_LLM_API_KEY=
EXPO_PUBLIC_LLM_MODEL=
EXPO_PUBLIC_LLM_BASE_URL=
# 联网搜索:Tavily 键真机可达位 EXPO_PUBLIC_TAVILY_API_KEY(webSearch.ts 优先读,
# 未配时回退 TAVILY_API_KEY——Node/server 路径仍走旧键);web 浏览器恒走
# /web-search 同源代理(DDG,免 key)。默认不启用——留空 = DDG 兜底。
EXPO_PUBLIC_TAVILY_API_KEY=
# 真机采集:TDX 服务器覆盖键 EXPO_PUBLIC_TDX_HOST(deviceCollect.ts 优先读,
# 未配时回退 TDX_HOST → 内置默认节点)。默认不启用——留空 = 内置节点
# (150.158.160.2 优先,实测可达列表兜底)。
EXPO_PUBLIC_TDX_HOST=
