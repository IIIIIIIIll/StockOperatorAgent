{
  "name": "expo-template-blank-typescript",
  "description": "The Blank project template includes the minimum dependencies to run and an empty root component.",
  "license": "0BSD",
  "version": "57.0.13",
  "main": "index.ts",
  "dependencies": {
    "buffer": "^6.0.3",
    "events": "^3.3.0",
    "expo": "~57.0.11",
    "expo-file-system": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "lightweight-charts": "^5.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-markdown-display": "^7.0.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-tcp-socket": "^6.4.2",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "node --experimental-strip-types node_modules/expo/bin/cli start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo export --platform web && node --experimental-strip-types server.mjs",
    "serve": "node --experimental-strip-types server.mjs",
    "chart:build": "node --experimental-transform-types ../tools/build-chart-view.mts",
    "chart:check": "node --experimental-transform-types ../tools/check-chart-view.mts"
  },
  "allowScripts": {
    "**": true
  }
}
