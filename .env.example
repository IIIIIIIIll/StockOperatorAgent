# 开关类键（TDX_MCP_DISABLED / WEB_SEARCH_DISABLED / BILLIONS_*_DISABLED）统一语义：
# 存在且值非空且非 "0"/"false"/"no" → 对应能力禁用；未设置或上述假值 → 启用。
# 判定集中在 utils/runtime_config.py 的 env_disabled（全库唯一实现）。
# 通达信 MCP（可选）：tdx_quant 实时市场情报（概念板块/资金流/大盘），
# 缺失时应用正常降级运行（跳过实时情报）
TDX_API_KEY=
# TDX_MCP_DISABLED=true            # 关闭实时市场情报（不查 MCP、不读写缓存；恢复 = 删键）

# 亿信 Fin 开放平台（可选）：公告/研报/新闻/推特检索 + 自然语言金融问数。
# 在 https://openapi.billionsintelligence.com/console/ 创建 API Key 并订阅所需 API。
# 配额限制较大（twitter/fetch 免费 30 次/天/用户；search/fin-db 按套餐计费），
# 未配置时应用完全降级运行（不产生任何亿信调用）；各能力可独立关闭。
BILLIONS_API_KEY=

# 亿信能力级开关（truthy 值如 true/1 即关闭对应能力；默认全部开启）
# BILLIONS_DISABLED=true            # 总闸：一键关闭全部亿信能力
# BILLIONS_FINDB_DISABLED=true      # 关闭 fin-db 金融问数前置段
# BILLIONS_SEARCH_DISABLED=true     # 关闭 search 检索工具（信息面分析师随之停用）
# BILLIONS_TWITTER_DISABLED=true    # 关闭 twitter 检索工具
# BILLIONS_FETCH_DISABLED=true      # 关闭 fetch 全文抓取工具
# BILLIONS_ANALYST_DISABLED=true    # 关闭信息面分析师节点（独立报告 Tab）

# 亿信 LLM 工具每次分析 run 的调用上限（防 15 轮工具循环烧配额；默认 3/2/3）
# BILLIONS_SEARCH_MAX_CALLS=3
# BILLIONS_TWITTER_MAX_CALLS=2
# BILLIONS_FETCH_MAX_CALLS=3

# LLM（OpenAI 兼容，任意供应商）：三键必填（R5 必填强校验——缺失任一
# 应用不渲染分析区）。改配置即换供应商：DeepSeek 官方
# （https://api.deepseek.com）、OpenCode Zen 网关
# （https://opencode.ai/zen/go/v1）、OpenAI、本地 vLLM/Ollama 网关等。
LLM_API_KEY=
# LLM_MODEL=deepseek-v4-flash        # 任意 OpenAI 兼容模型名（gpt-4o、qwen-plus-latest 等）
# LLM_BASE_URL=https://api.deepseek.com
# LLM_REASONING_EFFORT=max           # 可选：设了才传 reasoning_effort（DeepSeek 推理档；
#                                    # 空/未设 → 不传，任意兼容服务安全）

# 08-09 迁移说明：旧 DEEPSEEK_* 键已移除，映射如下（DASHSCOPE_API_KEY 已删）：
#   DEEPSEEK_API_KEY   → LLM_API_KEY
#   DEEPSEEK_MODEL     → LLM_MODEL
#   DEEPSEEK_BASE_URL  → LLM_BASE_URL

# 联网搜索（可选）：多空交易员/投资经理的 web_search 工具（DuckDuckGo，
# bind_tools 工具调用）。图装配时判定——关闭 = 不绑定工具，行为与无搜索一致。
# WEB_SEARCH_DISABLED=true

# LangSmith 追踪（可选）：https://smith.langchain.com 获取 API key（lsv2_...）
# 开启后 5 个 agent 的每次 LLM 调用（token/延迟/prompt/response）都会上报
# LANGSMITH_PROJECT 为你自己账户下的项目名（创建项目时生成，如 pr-xxx-xxx-xx）
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=YOUR_LANGSMITH_API_KEY_STARTING_WITH_lsv2_
LANGSMITH_PROJECT=

# 内部测试用（e2e 隔离）：覆盖 .env 文件路径（默认 REPO_ROOT/.env），无需手配
# ENV_FILE_PATH=
