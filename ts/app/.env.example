# Expo 客户端环境变量(浏览器可读;Expo dev/export 自动注入)
# LLM 三键兜底:设置面板未保存的键从这里补齐(对齐 Python 读 .env 语义)
EXPO_PUBLIC_LLM_API_KEY=
EXPO_PUBLIC_LLM_MODEL=
EXPO_PUBLIC_LLM_BASE_URL=
# 联网搜索:Tavily 仅在 Node 路径经 TAVILY_API_KEY 生效(webSearch.ts 消费);
# web 浏览器恒走 /web-search 同源代理(DDG,免 key)。EXPO_PUBLIC_TAVILY_API_KEY
# 已删除——键名与消费点不符(消费点是 process.env.TAVILY_API_KEY,08-14 审计 R9)。
